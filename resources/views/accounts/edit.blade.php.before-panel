<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Edit Akun | Bintang Silver</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#f5f7fb;font-family:Arial;color:#253047}
.container{max-width:800px;margin:35px auto;padding:20px}
.card{background:white;border:1px solid #e7ebf1;border-radius:12px;padding:25px}
h1{font-size:25px}.muted{color:#788399;font-size:13px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:25px}
.field{display:flex;flex-direction:column;gap:8px}.full{grid-column:1/-1}
label{font-size:13px;font-weight:bold}
input,select,textarea{padding:12px;border:1px solid #dce2ea;border-radius:8px;font:inherit;width:100%}
button,.btn{padding:12px 18px;border:0;border-radius:8px;text-decoration:none;cursor:pointer;font-size:13px}
.primary{background:#2457d6;color:white}.light{background:white;color:#344054;border:1px solid #ddd}
.notice{background:#eef4ff;color:#2457a6;padding:13px;border-radius:8px;margin-top:18px;font-size:13px}
.errors{background:#fff0f0;color:#b42318;padding:12px;border-radius:8px}
.actions{display:flex;gap:10px;margin-top:25px}
@media(max-width:600px){.grid{grid-template-columns:1fr}.full{grid-column:auto}}
</style>
</head>
<body>
<div class="container"><div class="card">
    <div class="muted">FINANCE & ACCOUNTING / MASTER COA</div>
    <h1>Edit Akun</h1>
    <p class="muted">Perbarui informasi akun {{ $account->code }}.</p>

    @if($account->is_system)
        <div class="notice">Akun bawaan sistem. Kode dan jenis akun dikunci.</div>
    @endif

    @if($errors->any())
        <div class="errors">@foreach($errors->all() as $error)<div>{{ $error }}</div>@endforeach</div>
    @endif

    <form action="{{ route('accounts.update',$account) }}" method="POST">
        @csrf
        @method('PUT')
        <div class="grid">
            <div class="field">
                <label>Kode Akun</label>
                <input name="code" value="{{ old('code',$account->code) }}" @readonly($account->is_system) required>
            </div>
            <div class="field">
                <label>Nama Akun *</label>
                <input name="name" value="{{ old('name',$account->name) }}" required>
            </div>
            <div class="field">
                <label>Jenis Akun</label>
                <select name="type" @disabled($account->is_system)>
                    @foreach($types as $key=>$label)
                        <option value="{{ $key }}" @selected(old('type',$account->type)===$key)>{{ $label }}</option>
                    @endforeach
                </select>
            </div>
            <div class="field">
                <label>Saldo Normal</label>
                <select name="normal_balance" @disabled($account->is_system)>
                    <option value="debit" @selected(old('normal_balance',$account->normal_balance)==='debit')>Debit</option>
                    <option value="credit" @selected(old('normal_balance',$account->normal_balance)==='credit')>Kredit</option>
                </select>
            </div>

            @if(!$account->is_system)
                <div class="field full">
                    <label>Akun Induk</label>
                    <select name="parent_id">
                        <option value="">Tanpa akun induk</option>
                        @foreach($parents as $parent)
                            <option value="{{ $parent->id }}" @selected(old('parent_id',$account->parent_id)==$parent->id)>
                                {{ $parent->code }} - {{ $parent->name }}
                            </option>
                        @endforeach
                    </select>
                </div>
            @endif

            <div class="field full">
                <label>Keterangan</label>
                <textarea name="description" rows="3">{{ old('description',$account->description) }}</textarea>
            </div>
            <div class="field full">
                <label><span><input type="checkbox" name="is_active" value="1" style="width:auto" @checked(old('is_active',$account->is_active)==true)> Akun aktif</span></label>
            </div>
        </div>
        <div class="actions">
            <button class="primary">Simpan Perubahan</button>
            <a href="{{ route('accounts.index') }}" class="btn light">Kembali</a>
        </div>
    </form>
</div></div>
</body>
</html>
